rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Quién es quién ───────────────────────────────────────────────────
    // Las reglas no pueden hacer consultas, y los ids de `ejecutivos` (e1, e2…)
    // no son el uid de Firebase Auth. Por eso el rol se lee de
    // perfiles/<correo en minúsculas>, un documento que la app (y el script
    // `npm run perfiles`) mantiene sincronizado con `ejecutivos`.
    function esPersonal() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@proservis[.](com[.])?co');
    }
    function miPerfil() {
      return /databases/$(database)/documents/perfiles/$(request.auth.token.email.lower());
    }
    function tienePerfil() {
      return esPersonal() && exists(miPerfil()) && get(miPerfil()).data.activo != false;
    }
    function rol() {
      return get(miPerfil()).data.role;
    }
    function esSuper() { return tienePerfil() && rol() == 'super_admin'; }
    function esAdmin() { return tienePerfil() && (rol() == 'admin' || rol() == 'super_admin'); }

    // ── Lectura ──────────────────────────────────────────────────────────
    // La app carga todas las colecciones al entrar y filtra por rol en pantalla,
    // así que cualquier persona de la empresa puede leer. (Si luego se quiere
    // ocultar datos por rol en la propia base, hay que cambiar cómo se cargan.)
    //
    // ── Escritura ────────────────────────────────────────────────────────
    //  • workspaces y areas: solo super admin.
    //  • ejecutivos y perfiles: super admin sin límite; admin puede gestionar
    //    personas pero nunca crear, editar ni borrar a un super admin.
    //  • clientes, informes, contribuciones, moduloConfigs: cualquier persona
    //    activa con perfil (el ejecutivo líder y los trabajadores de área
    //    editan ahí); borrar clientes solo admin.

    match /perfiles/{correo} {
      allow read: if esPersonal();
      allow create: if esSuper() || (esAdmin() && request.resource.data.role != 'super_admin');
      allow update: if esSuper() || (esAdmin() && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin');
      allow delete: if esSuper() || (esAdmin() && resource.data.role != 'super_admin');
    }

    match /ejecutivos/{id} {
      allow read: if esPersonal();
      allow create: if esSuper() || (esAdmin() && request.resource.data.role != 'super_admin');
      allow update: if esSuper() || (esAdmin() && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin');
      allow delete: if esSuper() || (esAdmin() && resource.data.role != 'super_admin');
    }

    match /workspaces/{id} {
      allow read: if esPersonal();
      allow write: if esSuper();
    }

    match /areas/{id} {
      allow read: if esPersonal();
      allow write: if esSuper();
    }

    match /clientes/{id} {
      allow read: if esPersonal();
      allow create, update: if tienePerfil();
      allow delete: if esAdmin();
    }

    // La aprobación de un informe (campo `aprobacion`) solo la puede poner o quitar un administrador;
    // el resto de campos los edita cualquier persona activa con perfil.
    function aprobacionIgual() {
      return request.resource.data.get('aprobacion', null) == resource.data.get('aprobacion', null);
    }
    match /informes/{id} {
      allow read: if esPersonal();
      allow create: if tienePerfil() && (esAdmin() || request.resource.data.get('aprobacion', null) == null);
      allow update: if tienePerfil() && (esAdmin() || aprobacionIgual());
      allow delete: if tienePerfil();
    }

    match /contribuciones/{id} {
      allow read: if esPersonal();
      allow write: if tienePerfil();
    }

    match /moduloConfigs/{id} {
      allow read: if esPersonal();
      allow write: if tienePerfil();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
