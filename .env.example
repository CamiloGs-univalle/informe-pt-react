# Copia este archivo a ".env.local" (no se sube a git) para sobreescribir
# la configuración por defecto en desarrollo. En producción, define estas
# mismas variables en tu proveedor de hosting (ver docs/DEPLOYMENT.md).
#
# Todas son opcionales: si no defines una variable, el código usa el valor
# por defecto del proyecto Firebase/Google actual (src/config/*.js), así
# que la app funciona igual sin este archivo.

# ── Firebase (proyecto: reportes-pt-ejecutivos) ──────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Google Drive (OAuth Client ID, console.cloud.google.com) ─────────────
VITE_GOOGLE_CLIENT_ID=
