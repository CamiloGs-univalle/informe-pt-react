  { id: 'c2', nom: 'Empresa Modelo ABC', marca: 'ABC', nit: '800.100.200-1', ciu: 'Bucaramanga', sec: 'Manufactura', ejId: 'e2', logo: null, driveFolder: '', workspaceId: 'w1' },
